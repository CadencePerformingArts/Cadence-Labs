# Cadence environment template. Copy to .env and fill in — never commit .env.
# Nothing here is required today: the app runs fully on snapshot/fixture data.

# --- Supabase (when the owner provisions a project; see supabase/README.md) ---
# Safe to ship in the app (anon key is public by design; RLS protects data):
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY — GitHub Actions environment secret, never in the app:
# SUPABASE_SERVICE_ROLE_KEY=

# --- RevenueCat (when billing work starts; sandbox first) ---
# EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
# EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# --- Error monitoring (optional, before beta) ---
# EXPO_PUBLIC_SENTRY_DSN=
